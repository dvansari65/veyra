    "format:check": "forge fmt --check",
    "demo": "forge script script/Demo.s.sol:Demo -vvv",
    "deploy:dry": "forge script script/Deploy.s.sol:Deploy -vvv"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "forge-std": "https://github.com/foundry-rs/forge-std/archive/77041d2ce690e692d6e03cc812b57d1ddaa4d505.tar.gz"
  }
}
